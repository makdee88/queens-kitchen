---
import Layout from '../layouts/Layout.astro';
import menuData from '../data/menu.json';
import settings from '../data/settings.json';
import DishImage from '../components/DishImage.astro';

const availableDishes = menuData.dishes.filter((d) => d.available !== false);

const categoryOrder = [
  'All',
  'Starters',
  'Biryani & Polao',
  'Chicken & Mutton',
  'Bengali Fish',
  'Vegetarian Mains',
  'Sides & Breads',
  'Bengali Desserts',
].filter((cat) => cat === 'All' || availableDishes.some((d) => d.category === cat));
---

<Layout title={`Our Bengali Menu | ${settings.business_name}`}>
  <section
    class="max-w-6xl mx-auto px-4 py-10 sm:py-14"
    x-data="{ activeCategory: 'All' }"
  >
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 border-b border-amber-200/80 pb-6 mb-8">
      <div class="max-w-2xl">
        <span class="text-xs font-bold uppercase tracking-widest text-amber-700">
          100% Beef-Free & Pork-Free Kitchen • West Bengal Heritage
        </span>
        <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-gray-900 mt-1">
          Our Bengali Menu
        </h1>
        <p class="text-gray-600 mt-2 text-sm leading-relaxed">
          Authentic Kolkata & West Bengal dishes prepared fresh in small batches. Browse by course below, then customize your platter on our Order page.
        </p>
      </div>

      <a
        href="/order"
        class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-amber-600 hover:bg-amber-500 text-white font-semibold text-sm shadow-sm transition shrink-0"
      >
        Build Order & Calculate Price →
      </a>
    </div>

    <!-- Category Filter Pills -->
    <div class="flex flex-wrap gap-2 mb-8">
      {categoryOrder.map((cat) => (
        <button
          type="button"
          @click={`activeCategory = '${cat}'`}
          :class={`activeCategory === '${cat}' ? 'bg-gray-900 text-white shadow-sm' : 'bg-white text-gray-700 border border-gray-200 hover:border-amber-300 hover:bg-amber-50/50'`}
          class="px-3.5 py-1.5 rounded-full text-xs sm:text-sm font-medium transition"
        >
          {cat}
        </button>
      ))}
    </div>

    <!-- Uniform Dish Showcase Grid -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {availableDishes.map((dish) => (
        <article
          x-show={`activeCategory === 'All' || activeCategory === '${dish.category}'`}
          class="group bg-white rounded-2xl border border-gray-200/90 overflow-hidden shadow-sm hover:shadow-md hover:border-amber-300 transition flex flex-col"
        >
          <div class="h-48 w-full overflow-hidden bg-amber-50 relative">
            <DishImage
              dish={dish}
              class="w-full h-full object-cover group-hover:scale-105 transition duration-300"
            />
            <span class="absolute top-3 left-3 text-[11px] font-semibold tracking-wide bg-white/95 text-gray-800 px-2.5 py-0.5 rounded-full shadow-xs">
              {dish.category}
            </span>
            {dish.extra_price > 0 ? (
              <span class="absolute top-3 right-3 text-[11px] font-bold bg-stone-900/85 text-amber-300 px-2.5 py-0.5 rounded-full">
                +{dish.extra_price} {menuData.currency}/pp
              </span>
            ) : (
              <span class="absolute top-3 right-3 text-[11px] font-semibold bg-emerald-800/90 text-white px-2.5 py-0.5 rounded-full">
                Base Included
              </span>
            )}
          </div>

          <div class="p-4 sm:p-5 flex-1 flex flex-col justify-between">
            <div>
              <h2 class="font-bold text-base sm:text-lg text-gray-900 leading-snug">{dish.name}</h2>
              {dish.description && (
                <p class="text-xs sm:text-sm text-gray-600 mt-1.5 leading-relaxed line-clamp-3">
                  {dish.description}
                </p>
              )}
            </div>

            {dish.dietary && dish.dietary.length > 0 && (
              <div class="flex flex-wrap gap-1.5 mt-4 pt-3 border-t border-gray-100">
                {dish.dietary.map((tag: string) => (
                  <span class="text-[11px] font-medium px-2 py-0.5 bg-amber-50 text-amber-900 border border-amber-200/60 rounded-md">
                    {tag}
                  </span>
                ))}
              </div>
            )}
          </div>
        </article>
      ))}
    </div>

    <!-- Bottom CTA Banner -->
    <div class="mt-12 bg-amber-950 text-white rounded-2xl p-6 sm:p-8 flex flex-col sm:flex-row items-center justify-between gap-6">
      <div>
        <h2 class="text-xl sm:text-2xl font-bold">Ready to customize your combo or Maharaja Thali?</h2>
        <p class="text-amber-200/85 text-sm mt-1">
          Pick your base package, select your favorite dishes, and get an instant price estimate.
        </p>
      </div>
      <a
        href="/order"
        class="px-5 py-3 rounded-xl bg-amber-500 hover:bg-amber-400 text-stone-950 font-bold text-sm transition shrink-0"
      >
        Go to Order Builder →
      </a>
    </div>
  </section>
</Layout>