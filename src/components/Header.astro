---
import settings from '../data/settings.json';

const currentPath = Astro.url.pathname;
const navLinks = [
  { label: 'Home', href: '/' },
  { label: 'About Us', href: '/about-us' },
  { label: 'Menu', href: '/menu' },
  { label: 'Events', href: '/events' },
  { label: 'Gallery', href: '/gallery' },
];

const logoSrc = settings.logo || '/images/qk_logo.jpg';
---

<header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-amber-200/70" x-data="{ mobileOpen: false }">
  <div class="max-w-7xl mx-auto px-4 h-16 flex items-center justify-between gap-4">
    <!-- Brand Logo & Name -->
    <a href="/" class="flex items-center gap-2.5 font-extrabold text-lg sm:text-xl text-gray-900 tracking-tight group">
      <img
        src={logoSrc}
        alt={`${settings.business_name} logo`}
        class="w-9 h-9 rounded-full object-cover border border-amber-300/80 shadow-xs bg-amber-50 group-hover:scale-105 transition shrink-0"
        onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
      />
      <span
        style="display: none;"
        class="w-9 h-9 rounded-full bg-amber-900 text-amber-300 items-center justify-center text-sm font-black shrink-0"
      >
        QK
      </span>
      <span>{settings.business_name}</span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-6 text-sm font-semibold">
      {navLinks.map((link) => {
        const isActive = currentPath === link.href;
        return (
          <a
            href={link.href}
            class={isActive
              ? 'text-amber-800 border-b-2 border-amber-700 py-1'
              : 'text-gray-700 hover:text-amber-800 transition py-1'}
          >
            {link.label}
          </a>
        );
      })}
      <a
        href="/order"
        class="px-4 py-2 rounded-xl bg-amber-600 hover:bg-amber-500 text-white font-bold shadow-sm transition"
      >
        Order / Quote
      </a>
    </nav>

    <!-- Mobile Menu Toggle -->
    <div class="flex items-center gap-2 md:hidden">
      <a
        href="/order"
        class="px-3 py-1.5 rounded-lg bg-amber-600 text-white text-xs font-bold"
      >
        Order
      </a>
      <button
        type="button"
        @click="mobileOpen = !mobileOpen"
        aria-label="Toggle navigation"
        class="p-2 rounded-lg text-gray-700 hover:bg-amber-50"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path x-show="!mobileOpen" stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          <path x-show="mobileOpen" stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown -->
  <div x-show="mobileOpen" x-cloak class="md:hidden border-t border-amber-100 bg-white px-4 py-4 space-y-2">
    {navLinks.map((link) => (
      <a
        href={link.href}
        class="block px-3 py-2 rounded-lg text-sm font-semibold text-gray-800 hover:bg-amber-50"
      >
        {link.label}
      </a>
    ))}
    <a
      href="/order"
      class="block text-center mt-2 px-4 py-2.5 rounded-xl bg-amber-600 text-white text-sm font-bold"
    >
      Build Custom Order & Quote
    </a>
  </div>
</header>