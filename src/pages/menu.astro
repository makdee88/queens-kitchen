---
import Layout from '../layouts/Layout.astro';
import menuData from '../data/menu.json';
import settings from '../data/settings.json';
import { getDishImage, DEFAULT_BENGALI_PLATE } from '../utils/dishImages';

const availableDishes = menuData.dishes.filter((d) => d.available !== false);

const categoryOrder = [
  'All',
  'Starters',
  'Biryani & Polao',
  'Chicken & Mutton',
  'Bengali Fish',
  'Vegetarian Mains',
  'Sides & Breads',
  'Bengali Desserts',
].filter((cat) => cat === 'All' || availableDishes.some((d) => d.category === cat));
---

<Layout title={`Our Bengali Menu | ${settings.business_name}`}>
  <section
    class="max-w-7xl mx-auto px-4 py-12"
    x-data="{ activeCategory: 'All' }"
  >
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 border-b border-amber-200/70 pb-8 mb-8">
      <div class="max-w-2xl">
        <span class="text-xs font-bold uppercase tracking-widest text-amber-700">
          100% Beef-Free & Pork-Free Kitchen • West Bengal Heritage
        </span>
        <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-gray-900 mt-1">
          Our Bengali Menu
        </h1>
        <p class="text-gray-600 mt-2 text-sm sm:text-base">
          Authentic Kolkata & West Bengal dishes prepared fresh in small batches. Browse by course below, then build your custom feast on our Order page.
        </p>
      </div>

      <a
        href="/order"
        class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-amber-600 hover:bg-amber-500 text-white font-bold text-sm shadow-md transition shrink-0"
      >
        Build Order & Calculate Price →
      </a>
    </div>

    <!-- Category Filter Tabs -->
    <div class="flex flex-wrap gap-2 mb-8">
      {categoryOrder.map((cat) => (
        <button
          type="button"
          @click={`activeCategory = '${cat}'`}
          :class={`activeCategory === '${cat}' ? 'bg-gray-900 text-white shadow-sm' : 'bg-amber-50/80 text-gray-800 border border-amber-200/60 hover:bg-amber-100'`}
          class="px-4 py-2 rounded-full text-xs sm:text-sm font-semibold transition"
        >
          {cat}
        </button>
      ))}
    </div>

    <!-- Compact Dish Showcase Grid -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {availableDishes.map((dish) => (
        <article
          x-show={`activeCategory === 'All' || activeCategory === '${dish.category}'`}
          class="group bg-white rounded-2xl border border-gray-200 overflow-hidden shadow-sm hover:shadow-md hover:border-amber-300 transition flex flex-col"
        >
          <div class="aspect-[16/10] w-full overflow-hidden bg-amber-50 relative">
            <img
              src={getDishImage(dish)}
              alt={dish.name}
              loading="lazy"
              referrerpolicy="no-referrer"
              onerror={`this.onerror=null; this.src='${DEFAULT_BENGALI_PLATE}';`}
              class="w-full h-full object-cover group-hover:scale-105 transition duration-300"
            />
            <span class="absolute top-3 left-3 text-[11px] font-bold uppercase tracking-wider bg-white/90 text-gray-900 px-2.5 py-1 rounded-full backdrop-blur-sm">
              {dish.category}
            </span>
            {dish.extra_price > 0 ? (
              <span class="absolute top-3 right-3 text-xs font-bold bg-stone-900/85 text-amber-300 px-2.5 py-1 rounded-full backdrop-blur-sm">
                +{dish.extra_price} {menuData.currency} / pp
              </span>
            ) : (
              <span class="absolute top-3 right-3 text-xs font-semibold bg-emerald-900/85 text-emerald-100 px-2.5 py-1 rounded-full backdrop-blur-sm">
                Base Included
              </span>
            )}
          </div>

          <div class="p-5 flex-1 flex flex-col justify-between">
            <div>
              <h2 class="font-bold text-lg text-gray-900 leading-snug">{dish.name}</h2>
              {dish.description && (
                <p class="text-xs sm:text-sm text-gray-600 mt-1.5 leading-relaxed">
                  {dish.description}
                </p>
              )}
            </div>

            {dish.dietary && dish.dietary.length > 0 && (
              <div class="flex flex-wrap gap-1.5 mt-4 pt-3 border-t border-gray-100">
                {dish.dietary.map((tag: string) => (
                  <span class="text-[11px] font-medium px-2 py-0.5 bg-amber-50 text-amber-900 border border-amber-200/60 rounded-full">
                    {tag}
                  </span>
                ))}
              </div>
            )}
          </div>
        </article>
      ))}
    </div>

    <!-- Bottom CTA Banner -->
    <div class="mt-14 bg-amber-950 text-white rounded-3xl p-8 flex flex-col sm:flex-row items-center justify-between gap-6">
      <div>
        <h2 class="text-2xl font-bold">Ready to customize your combo or Maharaja Thali?</h2>
        <p class="text-amber-200/85 text-sm mt-1">
          Pick your base package, select your favorite dishes, and get an instant price estimate.
        </p>
      </div>
      <a
        href="/order"
        class="px-6 py-3.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-stone-950 font-bold text-sm transition shrink-0"
      >
        Go to Order Builder →
      </a>
    </div>
  </section>
</Layout>