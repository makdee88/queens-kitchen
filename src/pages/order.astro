---
import Layout from '../layouts/Layout.astro';
import menuData from '../data/menu.json';
import settings from '../data/settings.json';
import DishImage from '../components/DishImage.astro';

const availableDishes = (menuData.dishes || []).filter((d) => d.available !== false);
const packages = menuData.packages || [];
const currency = menuData.currency || 'SEK';

const categories = [
  'All',
  'Starters',
  'Biryani & Polao',
  'Chicken & Mutton',
  'Bengali Fish',
  'Vegetarian Mains',
  'Sides & Breads',
  'Bengali Desserts',
].filter((cat) => cat === 'All' || availableDishes.some((d) => d.category === cat));

const initialData = JSON.stringify({
  packages,
  dishes: availableDishes,
  currency,
});
---

<Layout title={`Order & Catering Quote | ${settings.business_name}`}>
  <section
    class="max-w-6xl mx-auto px-4 py-10 sm:py-14"
    x-data={`orderBuilder(${initialData})`}
  >
    <!-- Header -->
    <div class="border-b border-amber-200/80 pb-6 mb-8">
      <span class="text-xs font-bold uppercase tracking-widest text-amber-700">
        Custom Platter & Catering Calculator • Stockholm
      </span>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-gray-900 mt-1">
        Build Your Bengali Feast
      </h1>
      <p class="text-gray-600 mt-2 text-sm max-w-2xl leading-relaxed">
        Choose a base package, set your guest count, and pick your favorite dishes. We will review your menu and confirm availability & delivery details shortly.
      </p>
    </div>

    <div class="grid lg:grid-cols-3 gap-8 items-start">
      <!-- Left 2 Columns: Package, Guests & Dish Selection -->
      <div class="lg:col-span-2 space-y-8">
        <!-- Step 1: Package & Guest Count -->
        <div class="bg-white rounded-2xl border border-gray-200/90 p-5 sm:p-6 shadow-xs">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-5">
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-amber-700">Step 1</span>
              <h2 class="text-lg sm:text-xl font-bold text-gray-900">Select Base Package & Guests</h2>
            </div>

            <!-- Guest Counter -->
            <div class="flex items-center gap-3 bg-stone-50 border border-gray-200 rounded-xl px-3.5 py-2">
              <label for="guest-count" class="text-xs font-semibold text-gray-700">Guests:</label>
              <button
                type="button"
                @click="decrementGuests()"
                class="w-7 h-7 rounded-lg bg-white border border-gray-300 text-gray-800 font-bold hover:bg-amber-50 transition"
                aria-label="Decrease guests"
              >
                −
              </button>
              <input
                id="guest-count"
                type="number"
                x-model.number="guests"
                @change="normalizeGuests()"
                :min="selectedPackage ? (selectedPackage.min_guests || 1) : 1"
                max="300"
                class="w-14 text-center text-sm font-bold text-gray-900 bg-transparent focus:outline-none"
              />
              <button
                type="button"
                @click="guests++"
                class="w-7 h-7 rounded-lg bg-white border border-gray-300 text-gray-800 font-bold hover:bg-amber-50 transition"
                aria-label="Increase guests"
              >
                +
              </button>
            </div>
          </div>

          <div class="grid sm:grid-cols-2 gap-4">
            <template x-for="pkg in packages" :key="pkg.name">
              <button
                type="button"
                @click="selectPackage(pkg)"
                :class="selectedPackage && selectedPackage.name === pkg.name
                  ? 'border-amber-600 bg-amber-50/60 ring-2 ring-amber-500/30'
                  : 'border-gray-200 bg-white hover:border-amber-300'"
                class="text-left rounded-xl border p-4 transition flex flex-col justify-between"
              >
                <div>
                  <div class="flex items-start justify-between gap-2">
                    <h3 class="font-bold text-base text-gray-900" x-text="pkg.name"></h3>
                    <span
                      class="text-xs font-extrabold px-2.5 py-1 rounded-full bg-amber-100 text-amber-950 shrink-0"
                      x-text="`${pkg.price_per_person} ${currency}/pp`"
                    ></span>
                  </div>
                  <p class="text-xs text-gray-600 mt-1.5 leading-relaxed" x-text="pkg.description"></p>
                </div>
                <div class="mt-3 pt-2.5 border-t border-gray-100 flex items-center justify-between text-[11px] font-medium text-gray-500">
                  <span x-text="`Min. ${pkg.min_guests || 1} guests`"></span>
                  <span
                    class="font-semibold"
                    :class="selectedPackage && selectedPackage.name === pkg.name ? 'text-amber-700' : 'text-gray-400'"
                    x-text="selectedPackage && selectedPackage.name === pkg.name ? '✓ Selected' : 'Select'"
                  ></span>
                </div>
              </button>
            </template>
          </div>
        </div>

        <!-- Step 2: Dish Selection -->
        <div class="bg-white rounded-2xl border border-gray-200/90 p-5 sm:p-6 shadow-xs">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-5">
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-amber-700">Step 2</span>
              <h2 class="text-lg sm:text-xl font-bold text-gray-900">Choose Your Dishes</h2>
            </div>
            <span class="text-xs font-semibold text-gray-600 bg-stone-100 px-3 py-1 rounded-full">
              <span x-text="selectedDishes.length"></span> selected
            </span>
          </div>

          <!-- Category Filter Tabs -->
          <div class="flex flex-wrap gap-1.5 mb-5">
            {categories.map((cat) => (
              <button
                type="button"
                @click={`activeCategory = '${cat}'`}
                :class={`activeCategory === '${cat}'
                  ? 'bg-gray-900 text-white'
                  : 'bg-stone-50 text-gray-700 border border-gray-200 hover:border-amber-300'`}
                class="px-3 py-1 rounded-full text-xs font-medium transition"
              >
                {cat}
              </button>
            ))}
          </div>

          <!-- Selectable Dish List -->
          <div class="grid sm:grid-cols-2 gap-3.5">
            {availableDishes.map((dish) => (
              <div
                x-show={`activeCategory === 'All' || activeCategory === '${dish.category}'`}
                @click={`toggleDish(${JSON.stringify(dish)})`}
                :class={`isDishSelected('${dish.name.replace(/'/g, "\\'")}')
                  ? 'border-amber-600 bg-amber-50/60 ring-1 ring-amber-500/40'
                  : 'border-gray-200 bg-white hover:border-amber-300'`}
                class="cursor-pointer rounded-xl border p-3 transition flex items-center gap-3 select-none"
              >
                <DishImage
                  dish={dish}
                  class="w-14 h-14 rounded-lg object-cover shrink-0 bg-amber-50 border border-amber-100"
                />

                <div class="flex-1 min-w-0">
                  <div class="flex items-start justify-between gap-2">
                    <h3 class="font-semibold text-sm text-gray-900 leading-snug truncate">
                      {dish.name}
                    </h3>
                    <span
                      :class={`isDishSelected('${dish.name.replace(/'/g, "\\'")}')
                        ? 'bg-amber-600 text-white border-amber-600'
                        : 'bg-white text-transparent border-gray-300'`}
                      class="w-5 h-5 rounded-md border flex items-center justify-center text-xs font-bold shrink-0 transition"
                    >
                      ✓
                    </span>
                  </div>

                  <div class="flex items-center gap-2 mt-1">
                    <span class="text-[11px] text-gray-500">{dish.category}</span>
                    <span class="text-gray-300">•</span>
                    {dish.extra_price > 0 ? (
                      <span class="text-[11px] font-bold text-amber-800">
                        +{dish.extra_price} {currency}/pp
                      </span>
                    ) : (
                      <span class="text-[11px] font-medium text-emerald-700">Included</span>
                    )}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Right Column: Sticky Summary & Contact Form -->
      <aside class="lg:sticky lg:top-24 bg-white rounded-2xl border border-gray-200/90 p-5 sm:p-6 shadow-sm">
        <span class="text-xs font-bold uppercase tracking-wider text-amber-700">Step 3</span>
        <h2 class="text-lg sm:text-xl font-bold text-gray-900 mb-4">Estimate & Inquiry</h2>

        <!-- Live Price Breakdown -->
        <div class="bg-stone-50 rounded-xl p-4 border border-stone-200/80 space-y-2.5 mb-5 text-sm">
          <div class="flex justify-between text-gray-700">
            <span>Package:</span>
            <span class="font-semibold text-gray-900" x-text="selectedPackage ? selectedPackage.name : '—'"></span>
          </div>
          <div class="flex justify-between text-gray-700">
            <span>Guests:</span>
            <span class="font-semibold text-gray-900" x-text="`${guests} people`"></span>
          </div>
          <div class="flex justify-between text-gray-700">
            <span>Rate per person:</span>
            <span class="font-semibold text-gray-900" x-text="`${pricePerPerson} ${currency}`"></span>
          </div>
          <div class="pt-2.5 border-t border-stone-200 flex justify-between items-baseline">
            <span class="font-bold text-gray-900">Estimated Total:</span>
            <span class="text-xl font-extrabold text-amber-700" x-text="`${totalPrice} ${currency}`"></span>
          </div>
        </div>

        <!-- Selected Dishes Pills -->
        <div class="mb-5">
          <div class="text-xs font-semibold text-gray-700 mb-2">
            Selected Dishes (<span x-text="selectedDishes.length"></span>):
          </div>
          <template x-if="selectedDishes.length === 0">
            <p class="text-xs text-gray-500 italic">No dishes selected yet—pick from Step 2.</p>
          </template>
          <div class="flex flex-wrap gap-1.5" x-show="selectedDishes.length > 0">
            <template x-for="d in selectedDishes" :key="d.name">
              <span class="inline-flex items-center gap-1 text-[11px] font-medium bg-amber-50 text-amber-950 border border-amber-200 px-2 py-0.5 rounded-md">
                <span x-text="d.name"></span>
                <button
                  type="button"
                  @click="toggleDish(d)"
                  class="text-amber-700 hover:text-red-600 font-bold ml-0.5"
                  aria-label="Remove dish"
                >
                  ×
                </button>
              </span>
            </template>
          </div>
        </div>

        <!-- Success Banner -->
        <div
          x-show="submitted"
          x-cloak
          class="rounded-xl bg-emerald-50 border border-emerald-200 p-4 text-emerald-900 text-sm space-y-2"
        >
          <div class="font-bold text-base">✓ Inquiry Sent!</div>
          <p class="text-xs leading-relaxed">
            Thank you, <span class="font-semibold" x-text="form.name"></span>! We have received your menu request and will contact you shortly on phone or email to finalize your event.
          </p>
          <button
            type="button"
            @click="resetSuccess()"
            class="mt-2 inline-block text-xs font-semibold underline text-emerald-800 hover:text-emerald-950"
          >
            Submit another inquiry
          </button>
        </div>

        <!-- Contact Form -->
        <form x-show="!submitted" @submit.prevent="submitOrder()" class="space-y-3.5" novalidate>
          <div>
            <label for="cust-name" class="block text-xs font-semibold text-gray-700 mb-1">
              Your Name *
            </label>
            <input
              id="cust-name"
              type="text"
              x-model="form.name"
              required
              placeholder="Full name"
              class="w-full rounded-xl border border-gray-300 px-3.5 py-2 text-sm focus:border-amber-500 focus:outline-none focus:ring-2 focus:ring-amber-500/20"
            />
          </div>

          <div>
            <label for="cust-email" class="block text-xs font-semibold text-gray-700 mb-1">
              Email Address *
            </label>
            <input
              id="cust-email"
              type="email"
              x-model="form.email"
              @blur="touched.email = true"
              required
              placeholder="you@example.com"
              :class="touched.email && form.email && !isValidEmail(form.email)
                ? 'border-red-400 focus:border-red-500 focus:ring-red-500/20'
                : 'border-gray-300 focus:border-amber-500 focus:ring-amber-500/20'"
              class="w-full rounded-xl border px-3.5 py-2 text-sm focus:outline-none focus:ring-2"
            />
            <p
              x-show="touched.email && form.email && !isValidEmail(form.email)"
              x-cloak
              class="text-[11px] text-red-600 mt-1"
            >
              Enter a valid email address (e.g. name@example.com).
            </p>
          </div>

          <div>
            <label for="cust-phone" class="block text-xs font-semibold text-gray-700 mb-1">
              Swedish Phone Number *
            </label>
            <input
              id="cust-phone"
              type="tel"
              x-model="form.phone"
              @blur="touched.phone = true"
              required
              placeholder="070-123 45 67 or +46 70 123 45 67"
              :class="touched.phone && form.phone && !isValidSwedishPhone(form.phone)
                ? 'border-red-400 focus:border-red-500 focus:ring-red-500/20'
                : 'border-gray-300 focus:border-amber-500 focus:ring-amber-500/20'"
              class="w-full rounded-xl border px-3.5 py-2 text-sm focus:outline-none focus:ring-2"
            />
            <p
              x-show="touched.phone && form.phone && !isValidSwedishPhone(form.phone)"
              x-cloak
              class="text-[11px] text-red-600 mt-1"
            >
              Must be a valid Swedish number (e.g. 070-123 45 67 or +46 70 123 45 67).
            </p>
          </div>

          <div>
            <label for="event-date" class="block text-xs font-semibold text-gray-700 mb-1">
              Event / Pickup Date
            </label>
            <input
              id="event-date"
              type="date"
              x-model="form.event_date"
              class="w-full rounded-xl border border-gray-300 px-3.5 py-2 text-sm focus:border-amber-500 focus:outline-none focus:ring-2 focus:ring-amber-500/20"
            />
          </div>

          <div>
            <label for="cust-notes" class="block text-xs font-semibold text-gray-700 mb-1">
              Notes (Spice level, allergies, delivery area)
            </label>
            <textarea
              id="cust-notes"
              rows="3"
              x-model="form.notes"
              placeholder="e.g., Medium spice, nut allergy, delivery to Kista/Solna..."
              class="w-full rounded-xl border border-gray-300 px-3.5 py-2 text-sm focus:border-amber-500 focus:outline-none focus:ring-2 focus:ring-amber-500/20"
            ></textarea>
          </div>

          <!-- Error Banner -->
          <div
            x-show="errorMsg"
            x-cloak
            class="rounded-xl bg-red-50 border border-red-200 px-3.5 py-2.5 text-xs font-medium text-red-700"
            x-text="errorMsg"
          ></div>

          <button
            type="submit"
            :disabled="submitting"
            class="w-full py-3 px-4 rounded-xl bg-amber-600 hover:bg-amber-500 disabled:opacity-60 text-white font-bold text-sm shadow-sm transition cursor-pointer"
          >
            <span x-show="!submitting">Send Menu & Request Quote →</span>
            <span x-show="submitting" x-cloak>Sending Inquiry...</span>
          </button>
        </form>
      </aside>
    </div>
  </section>

  <script is:inline>
    function orderBuilder(config) {
      const defaultPkg = config.packages && config.packages.length > 0 ? config.packages[0] : null;
      return {
        packages: config.packages || [],
        dishes: config.dishes || [],
        currency: config.currency || 'SEK',
        activeCategory: 'All',
        selectedPackage: defaultPkg,
        guests: defaultPkg ? Math.max(10, Number(defaultPkg.min_guests || 10)) : 10,
        selectedDishes: [],
        submitting: false,
        submitted: false,
        errorMsg: '',
        touched: {
          email: false,
          phone: false,
        },
        form: {
          name: '',
          email: '',
          phone: '',
          event_date: '',
          notes: '',
        },

        selectPackage(pkg) {
          this.selectedPackage = pkg;
          const min = Number(pkg.min_guests || 1);
          if (this.guests < min) {
            this.guests = min;
          }
        },

        decrementGuests() {
          const min = this.selectedPackage ? Number(this.selectedPackage.min_guests || 1) : 1;
          if (this.guests > min) {
            this.guests--;
          }
        },

        normalizeGuests() {
          const min = this.selectedPackage ? Number(this.selectedPackage.min_guests || 1) : 1;
          if (!this.guests || this.guests < min) {
            this.guests = min;
          }
        },

        isDishSelected(name) {
          return this.selectedDishes.some((d) => d.name === name);
        },

        toggleDish(dish) {
          const idx = this.selectedDishes.findIndex((d) => d.name === dish.name);
          if (idx >= 0) {
            this.selectedDishes.splice(idx, 1);
          } else {
            this.selectedDishes.push({
              name: dish.name,
              category: dish.category,
              extra_price: Number(dish.extra_price || 0),
            });
          }
        },

        get pricePerPerson() {
          const base = this.selectedPackage ? Number(this.selectedPackage.price_per_person || 0) : 0;
          const extras = this.selectedDishes.reduce((sum, d) => sum + Number(d.extra_price || 0), 0);
          return base + extras;
        },

        get totalPrice() {
          return this.pricePerPerson * Number(this.guests || 0);
        },

        isValidEmail(email) {
          return /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(String(email || '').trim());
        },

        isValidSwedishPhone(phone) {
          const cleaned = String(phone || '').trim();
          if (!/^(?:\+46|0046|0)[\s-]*(?:7[02369]|[1-9]\d{0,2})[\s-]*(?:\d[\s-]*){5,8}$/.test(cleaned)) {
            return false;
          }
          const digits = cleaned.replace(/\D/g, '');
          if (digits.startsWith('0046')) return digits.length >= 12 && digits.length <= 13;
          if (digits.startsWith('46')) return digits.length >= 10 && digits.length <= 11;
          if (digits.startsWith('0')) return digits.length >= 9 && digits.length <= 10;
          return false;
        },

        resetSuccess() {
          this.submitted = false;
          this.errorMsg = '';
        },

        async submitOrder() {
          this.errorMsg = '';
          this.touched.email = true;
          this.touched.phone = true;

          if (!this.form.name || !this.form.name.trim()) {
            this.errorMsg = 'Please enter your name.';
            return;
          }

          if (!this.isValidEmail(this.form.email)) {
            this.errorMsg = 'Please enter a valid email address (e.g. name@example.com).';
            return;
          }

          if (!this.isValidSwedishPhone(this.form.phone)) {
            this.errorMsg = 'Please enter a valid Swedish phone number (e.g. 070-123 45 67 or +46 70 123 45 67).';
            return;
          }

          if (this.selectedDishes.length === 0) {
            this.errorMsg = 'Please select at least one dish for your menu.';
            return;
          }

          this.submitting = true;

          try {
            const payload = {
              name: this.form.name.trim(),
              email: this.form.email.trim(),
              phone: this.form.phone.trim(),
              event_date: this.form.event_date || '',
              notes: this.form.notes.trim(),
              guests: Number(this.guests),
              package_name: this.selectedPackage ? this.selectedPackage.name : '',
              selected_dishes: this.selectedDishes,
              price_per_person: this.pricePerPerson,
              total_price: this.totalPrice,
              currency: this.currency,
            };

            const res = await fetch('/api/submit-order', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload),
            });

            if (!res.ok) {
              const errData = await res.json().catch(() => ({}));
              throw new Error(errData.error || `Request failed (${res.status})`);
            }

            this.submitted = true;
          } catch (err) {
            this.errorMsg =
              err?.message ||
              'Could not send request right now. Please try again or contact us on Facebook/Phone.';
          } finally {
            this.submitting = false;
          }
        },
      };
    }
  </script>
</Layout>