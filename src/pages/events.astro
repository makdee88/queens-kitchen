---
import Layout from '../layouts/Layout.astro';
import settings from '../data/settings.json';

const eventImports = import.meta.glob('../content/events/*.md', { eager: true });
const events = Object.values(eventImports)
  .map((file: any) => ({
    ...file.frontmatter,
    Content: file.Content,
  }))
  .filter((event) => event.active !== false)
  .sort((a, b) => new Date(a.event_date).getTime() - new Date(b.event_date).getTime());
---

<Layout title={`Upcoming Events | ${settings.business_name}`}>
  <section class="max-w-6xl mx-auto px-4 py-16">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <h1 class="text-4xl font-bold tracking-tight mb-4">Upcoming Events</h1>
      <p class="text-gray-600">
        Discover our latest pop-ups, seasonal feasts, and tasting nights from {settings.business_name}.
      </p>
    </div>

    {events.length === 0 ? (
      <div class="text-center py-12 bg-amber-50/60 rounded-2xl border border-amber-100">
        <p class="text-lg font-medium text-gray-700">New events are being announced soon!</p>
        <p class="text-sm text-gray-500 mt-1">Want to host a private event? Build a custom menu combo on our Menu page.</p>
      </div>
    ) : (
      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {events.map((event) => {
          const formattedDate = new Date(event.event_date).toLocaleDateString('en-SE', {
            weekday: 'short',
            year: 'numeric',
            month: 'short',
            day: 'numeric',
            hour: '2-digit',
            minute: '2-digit',
          });

          return (
            <article class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden flex flex-col">
              {event.banner && (
                <img
                  src={event.banner}
                  alt={event.title}
                  class="w-full h-52 object-cover"
                  loading="lazy"
                />
              )}
              <div class="p-6 flex-1 flex flex-col">
                <div class="text-xs font-semibold uppercase tracking-wider text-amber-700 mb-2">
                  {formattedDate} • {event.location}
                </div>
                <h2 class="text-xl font-bold text-gray-900 mb-2">{event.title}</h2>
                {event.price_note && (
                  <span class="inline-block self-start bg-amber-100 text-amber-900 text-xs font-medium px-2.5 py-1 rounded-full mb-3">
                    {event.price_note}
                  </span>
                )}
                <div class="prose prose-sm text-gray-600 mb-6 flex-1">
                  <event.Content />
                </div>
                <a
                  href="/menu"
                  class="mt-auto inline-flex justify-center items-center w-full py-2.5 px-4 rounded-xl bg-gray-900 text-white font-medium hover:bg-amber-700 transition"
                >
                  Build Menu Combo
                </a>
              </div>
            </article>
          );
        })}
      </div>
    )}
  </section>
</Layout>