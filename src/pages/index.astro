---
import Layout from '../layouts/Layout.astro';
import settings from '../data/settings.json';
import menuData from '../data/menu.json';
import { getDishImage, DEFAULT_BENGALI_PLATE } from '../utils/dishImages';

const eventImports = import.meta.glob('../content/events/*.md', { eager: true });
const upcomingEvents = Object.values(eventImports)
  .map((file: any) => ({
    ...file.frontmatter,
    Content: file.Content,
  }))
  .filter((event) => event.active !== false)
  .sort((a, b) => new Date(a.event_date).getTime() - new Date(b.event_date).getTime())
  .slice(0, 3);

const featuredDishes = menuData.dishes.filter((d) => d.available !== false).slice(0, 6);
---

<Layout title={`${settings.business_name} | Authentic West Bengal Cuisine in Stockholm`}>
  {settings.banner_notice && (
    <div class="bg-amber-900 text-amber-50 text-center text-xs sm:text-sm py-2.5 px-4 font-medium tracking-wide">
      {settings.banner_notice}
    </div>
  )}

  <!-- Hero Section -->
  <section class="relative bg-gradient-to-br from-amber-950 via-red-950 to-stone-900 text-white overflow-hidden">
    <div class="max-w-6xl mx-auto px-4 py-20 sm:py-28 grid lg:grid-cols-12 gap-10 items-center">
      <div class="lg:col-span-7 space-y-6">
        <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold uppercase tracking-widest bg-amber-500/20 text-amber-300 border border-amber-400/30">
          Stockholm • Flavors of West Bengal, India
        </span>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight leading-tight">
          Authentic Taste of Kolkata & West Bengal in Stockholm
        </h1>
        <p class="text-base sm:text-lg text-amber-100/85 max-w-2xl leading-relaxed">
          From aromatic Kolkata Dum Biryani and slow-cooked Kosha Mangsho (mutton) to mustard fish delicacies, Luchi-Aloor Dom, and traditional Mishti — crafted fresh for your celebrations.
        </p>

        <div class="flex flex-wrap gap-4 pt-2">
          <a
            href="/order"
            class="px-6 py-3.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-stone-950 font-bold text-sm sm:text-base shadow-lg transition"
          >
            Build Custom Order
          </a>
          <a
            href="/menu"
            class="px-6 py-3.5 rounded-xl bg-white/10 hover:bg-white/20 text-white border border-white/20 font-semibold text-sm sm:text-base transition"
          >
            Explore Full Menu
          </a>
        </div>

        <div class="pt-4 flex flex-wrap items-center gap-6 text-sm text-amber-200/80">
          <a
            href={settings.facebook_url}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 hover:text-white underline underline-offset-4"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z" />
            </svg>
            Follow Queen's Kitchen Stockholm on Facebook
          </a>
          <span class="text-xs bg-white/10 px-3 py-1 rounded-full text-amber-200">
            100% Beef-Free & Pork-Free Kitchen
          </span>
        </div>
      </div>

      <!-- Highlight Card -->
      <div class="lg:col-span-5">
        <div class="bg-white/10 backdrop-blur-md border border-white/15 rounded-3xl p-6 sm:p-8 space-y-5 shadow-2xl">
          <div class="text-xs font-bold uppercase tracking-widest text-amber-300">
            Custom Event & Party Catering
          </div>
          <h2 class="text-2xl font-bold">Plan Your Bengali Feast in Minutes</h2>
          <ul class="space-y-3 text-sm text-amber-50/90">
            <li class="flex items-start gap-2.5">
              <span class="text-amber-400 font-bold">✓</span>
              <span>Choose from Kolkata Bhoj, Royal 3-Course, or our signature Maharaja Thali</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-amber-400 font-bold">✓</span>
              <span>Mix & match Chicken, Mutton, Seafood, Pure Vegetarian & Vegan dishes</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-amber-400 font-bold">✓</span>
              <span>Instant per-person and total price estimate for your guest count</span>
            </li>
          </ul>
          <a
            href="/order"
            class="block text-center w-full py-3 rounded-xl bg-white text-stone-950 font-bold text-sm hover:bg-amber-100 transition"
          >
            Calculate Order Price →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- West Bengal Specialties Strip -->
  <section class="max-w-6xl mx-auto px-4 py-16">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <span class="text-xs font-bold uppercase tracking-widest text-amber-700">Culinary Heritage of West Bengal</span>
      <h2 class="text-3xl font-bold text-gray-900 mt-1">From Kolkata Kitchens to Stockholm</h2>
      <p class="text-gray-600 mt-2 text-sm sm:text-base">
        Prepared fresh using freshly ground panch phoron, Kasundi mustard, ghee, and authentic family recipes from West Bengal, India.
      </p>
    </div>

    <div class="grid sm:grid-cols-3 gap-6">
      <div class="p-6 rounded-2xl bg-amber-50/60 border border-amber-100">
        <h3 class="font-bold text-lg text-gray-900 mb-2">Kolkata Biryani & Basanti Polao</h3>
        <p class="text-sm text-gray-600">
          Subtly spiced saffron dum biryani with tender chicken or mutton and golden potatoes, alongside sweet-savory cashew-raisin polao.
        </p>
      </div>
      <div class="p-6 rounded-2xl bg-amber-50/60 border border-amber-100">
        <h3 class="font-bold text-lg text-gray-900 mb-2">Kosha Mangsho & Shorshe Maach</h3>
        <p class="text-sm text-gray-600">
          Slow-caramelized mutton curry, classic Kolkata Fish Fry with Kasundi, and pungent mustard-simmered fish delicacies.
        </p>
      </div>
      <div class="p-6 rounded-2xl bg-amber-50/60 border border-amber-100">
        <h3 class="font-bold text-lg text-gray-900 mb-2">Luchi-Aloor Dom & Kolkata Mishti</h3>
        <p class="text-sm text-gray-600">
          Fluffy puffed luchi with cholar dal, followed by soft Rosogolla, baked Mishti Doi, and artisanal Sandesh.
        </p>
      </div>
    </div>
  </section>

  <!-- Latest Events Section -->
  <section class="bg-stone-50 border-y border-stone-200/70 py-16">
    <div class="max-w-6xl mx-auto px-4">
      <div class="flex flex-wrap items-end justify-between gap-4 mb-10">
        <div>
          <span class="text-xs font-bold uppercase tracking-widest text-amber-700">What's Happening</span>
          <h2 class="text-3xl font-bold text-gray-900 mt-1">Latest Events & Pop-Ups</h2>
        </div>
        <a href="/events" class="text-sm font-semibold text-amber-800 hover:underline">
          View all events →
        </a>
      </div>

      {upcomingEvents.length === 0 ? (
        <div class="bg-white p-8 rounded-2xl border border-gray-200 text-center">
          <p class="text-gray-700 font-medium">Stay tuned for our next Stockholm pop-up event!</p>
          <a
            href={settings.facebook_url}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block mt-3 text-sm font-semibold text-amber-800 hover:underline"
          >
            Check latest updates on our Facebook page →
          </a>
        </div>
      ) : (
        <div class="grid md:grid-cols-3 gap-6">
          {upcomingEvents.map((event) => {
            const dateLabel = new Date(event.event_date).toLocaleDateString('en-SE', {
              month: 'short',
              day: 'numeric',
              year: 'numeric',
            });
            return (
              <article class="bg-white rounded-2xl border border-gray-200 overflow-hidden shadow-sm flex flex-col">
                {event.banner && (
                  <img src={event.banner} alt={event.title} class="w-full h-44 object-cover" loading="lazy" />
                )}
                <div class="p-6 flex-1 flex flex-col">
                  <div class="text-xs font-bold uppercase text-amber-700 mb-1">
                    {dateLabel} • {event.location}
                  </div>
                  <h3 class="text-lg font-bold text-gray-900 mb-2">{event.title}</h3>
                  {event.price_note && (
                    <span class="inline-block self-start text-xs bg-amber-100 text-amber-900 px-2.5 py-0.5 rounded-full font-medium mb-3">
                      {event.price_note}
                    </span>
                  )}
                  <div class="text-sm text-gray-600 line-clamp-3 mb-4 flex-1">
                    <event.Content />
                  </div>
                  <a
                    href="/events"
                    class="text-sm font-semibold text-gray-900 hover:text-amber-700 transition"
                  >
                    Event Details →
                  </a>
                </div>
              </article>
            );
          })}
        </div>
      )}
    </div>
  </section>

  <!-- Sample Menu Preview with Dish Photos + Combo CTA -->
  <section class="max-w-6xl mx-auto px-4 py-16">
    <div class="flex flex-wrap items-end justify-between gap-4 mb-10">
      <div>
        <span class="text-xs font-bold uppercase tracking-widest text-amber-700">Catering & Combos</span>
        <h2 class="text-3xl font-bold text-gray-900 mt-1">Signature West Bengal Selections</h2>
        <p class="text-gray-600 mt-1 text-sm">
          Explore our full menu or customize your own combination for birthdays, Puja gatherings, and corporate lunches.
        </p>
      </div>
      <a href="/menu" class="text-sm font-semibold text-amber-800 hover:underline">
        View all dishes →
      </a>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5 mb-10">
      {featuredDishes.map((dish) => (
        <div class="p-4 rounded-2xl border border-gray-200 bg-white flex items-start gap-4 shadow-sm hover:border-amber-300 transition">
          <img
            src={getDishImage(dish)}
            alt={dish.name}
            loading="lazy"
            referrerpolicy="no-referrer"
            class="w-20 h-20 rounded-xl object-cover shrink-0 border border-amber-100 bg-amber-50"
          />
          <div class="flex-1 min-w-0">
            <div class="flex items-center justify-between gap-2 mb-1">
              <span class="text-[11px] font-bold uppercase tracking-wider text-amber-700">{dish.category}</span>
              {dish.extra_price > 0 && (
                <span class="text-[11px] bg-amber-100 text-amber-900 px-2 py-0.5 rounded-full font-semibold shrink-0">
                  +{dish.extra_price} {menuData.currency}
                </span>
              )}
            </div>
            <h3 class="font-bold text-gray-900 text-base leading-snug">{dish.name}</h3>
            {dish.description && <p class="text-xs text-gray-600 mt-1 line-clamp-2">{dish.description}</p>}
          </div>
        </div>
      ))}
    </div>

    <div class="bg-amber-950 text-white rounded-3xl p-8 sm:p-10 flex flex-col md:flex-row items-center justify-between gap-6">
      <div>
        <h3 class="text-2xl font-bold">Ready to create your custom Bengali menu?</h3>
        <p class="text-amber-200/85 text-sm mt-1">
          Select dishes, set your guest count, and send your combo inquiry directly to our kitchen.
        </p>
      </div>
      <div class="flex flex-wrap gap-3 shrink-0">
        <a
          href="/order"
          class="px-6 py-3 rounded-xl bg-amber-500 hover:bg-amber-400 text-stone-950 font-bold text-sm transition"
        >
          Open Order Calculator
        </a>
        <a
          href="/menu"
          class="px-6 py-3 rounded-xl bg-white/10 hover:bg-white/20 text-white font-semibold text-sm transition"
        >
          Browse Full Menu
        </a>
      </div>
    </div>
  </section>
</Layout>