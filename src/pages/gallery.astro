---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import galleryData from '../data/gallery.json';
import settings from '../data/settings.json';

// Load all images in src/assets/gallery/ for automatic WebP compression
const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/gallery/*.{jpeg,jpg,png,webp,JPG,JPEG,PNG}',
  { eager: true }
);

const photos = (galleryData.photos || [])
  .map((item: any) => ({
    ...item,
    resolvedImage: imageModules[item.image]?.default,
  }))
  .filter((item: any) => item.resolvedImage);
---

<Layout title={`Gallery | ${settings.business_name}`}>
  <section class="max-w-6xl mx-auto px-4 py-16">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <span class="text-xs font-bold uppercase tracking-widest text-amber-700">Visual Feast</span>
      <h1 class="text-4xl font-bold text-gray-900 mt-1">Food & Event Gallery</h1>
      <p class="text-gray-600 mt-2 text-sm">
        A glimpse into our West Bengal delicacies, festive catering spreads, and Stockholm pop-up events.
      </p>
    </div>

    {photos.length === 0 ? (
      <div class="text-center py-12 bg-amber-50/60 rounded-2xl border border-amber-100">
        <p class="text-gray-700 font-medium">Gallery photos coming soon!</p>
        <a
          href={settings.facebook_url}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block mt-2 text-sm font-semibold text-amber-800 hover:underline"
        >
          See our latest food photos on Facebook →
        </a>
      </div>
    ) : (
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {photos.map((photo: any) => (
          <figure class="group bg-white rounded-2xl border border-gray-200 overflow-hidden shadow-sm">
            <div class="aspect-[4/3] overflow-hidden bg-gray-100">
              <Image
                src={photo.resolvedImage}
                alt={photo.caption}
                width={800}
                quality={82}
                format="webp"
                class="w-full h-full object-cover group-hover:scale-105 transition duration-300"
              />
            </div>
            <figcaption class="p-4 flex items-center justify-between gap-2">
              <span class="font-semibold text-sm text-gray-900">{photo.caption}</span>
              {photo.category && (
                <span class="text-[11px] px-2 py-0.5 rounded-full bg-amber-100 text-amber-900 shrink-0">
                  {photo.category}
                </span>
              )}
            </figcaption>
          </figure>
        ))}
      </div>
    )}
  </section>
</Layout>